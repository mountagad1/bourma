# URL publique du site (URL canoniques, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Facultatif : point d'envoi du formulaire de contact (POST JSON),
# par ex. un formulaire Formspree/Getform ou une route API interne.
# Sans cette variable, le formulaire ouvre la messagerie du visiteur
# avec la demande pré-remplie (aucun envoi n'est simulé).
NEXT_PUBLIC_FORM_ENDPOINT=
